    "definitions": {
        "dto.ApiResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "message": {
                    "type": "string"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "dto.CreateSemesterRequest": {
            "type": "object",
            "required": [
                "term",
                "year"
            ],
            "properties": {
                "term": {
                    "type": "integer",
                    "maximum": 2,
                    "minimum": 1
                },
                "year": {
                    "type": "integer",
                    "maximum": 2050,
                    "minimum": 2020
                }
            }
        },
        "dto.CreateUserRequest": {
            "type": "object",
            "required": [
                "email",
                "full_name",
                "password",
                "role_id",
                "rut"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "full_name": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 6
                },
                "role_id": {
                    "type": "integer"
                },
                "rut": {
                    "type": "string"
                }
            }
        },
        "dto.ErrorResponse": {
